[gd_resource type="Resource" script_class="EventDefinition" format=3]

[ext_resource type="Script" path="res://core/progression/event_definition.gd" id="1_event"]

[resource]
script = ExtResource("1_event")
id = &"natal"
title = "Natal no Café"
start_month = 12
start_day = 1
end_month = 12
end_day = 26
speaker = "Papai Noel"
portrait = "retrato_papai_noel"
story = Array[String](["Ho, ho, ho! Que café aconchegante! Eu sou o Papai Noel, e vim pedir uma ajudinha.", "Meu forno de biscoitos esfriou bem na véspera da grande ceia. Sem ele, as renas e os duendes ficam sem lanche!", "Cumpra as missões de Natal antes da noite do dia 26. A cada missão, eu esquento um pouco mais o meu Forno do Papai Noel...", "...e ele fica com você! Quanto mais missões, mais rápido ele assa. E quem completar tudo ganha a Árvore de Natal!"])
missions_dir = "res://data/events/natal"
prize_stove = &"santa_oven"
stove_levels_at = PackedInt32Array(1, 3, 5)
icon = "medalhao_natal"
final_prize = &"christmas_tree"
